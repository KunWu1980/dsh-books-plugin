{
  "name": "@local/books",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "In-Harness book reader and library manager (TXT/EPUB/PDF/AZW3)",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "nlc.js",
    "guangdong.js",
    "shaanxi.js",
    "sources.js",
    "sources-index.json",
    "client.js",
    "extractor.py",
    "render_page.py",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
